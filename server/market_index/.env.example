DATABASE_URL=mysql+pymysql://ahu_plus_app:REPLACE_ME@TDSQL_PRIVATE_HOST:PORT/ahu_plus?charset=utf8mb4
MARKET_INDEX_CURSOR_SECRET=replace-with-a-long-random-secret
MARKET_SOURCE_TOKEN=Bearer replace-with-rotated-source-token
MARKET_SOURCE_SCHOOL_ID=10681
MARKET_POLL_INTERVAL_SECONDS=120
MARKET_SOURCE_MIN_INTERVAL_SECONDS=1
MARKET_PUBLIC_RATE_LIMIT_PER_MINUTE=30
MARKET_PUBLIC_RATE_LIMIT_MAX_KEYS=10000
MARKET_GLOBAL_RATE_LIMIT_QPS=500
# ⚠️ SECURITY WARNING: TRUSTED_PROXY_CIDRS must ONLY contain controlled reverse proxy networks.
# - CORRECT: 172.18.0.0/16 (internal Docker network)
# - WRONG: 0.0.0.0/0, public CDN CIDRs (allows X-Forwarded-For spoofing)
# Leave empty to safely rate-limit by direct connection peer instead of trusting forwarded headers.
MARKET_TRUSTED_PROXY_CIDRS=
